+function data = aps_load_era_getvar(ncvars,names)
+% NEW-CDS: return the first field of the ncvars struct matching one of names,
+% or [] when none of them is present.
+data = [];
+for k = 1:numel(names)
+    if isfield(ncvars,names{k})
+        data = ncvars.(names{k});
+        return
+    end
+end
+end
